# Supabase PostgreSQL - Session Pooler (IPv4)
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-supabase-pooler-user
DB_PASSWORD=your-database-password

# Alternatively, configure the full connection URL:
DATABASE_URL=postgresql://your-user:your-password@your-host:5432/your-database